# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local dev (outside Docker). docker compose overrides this with the internal "db" host.
DATABASE_URL=postgres://app:app@localhost:5432/imagematch

# --- Gemini (free tier, AI Studio key — no credit card) ---
GEMINI_API_KEY=your-ai-studio-key-here
# Pick the current free-tier models from the AI Studio docs (see docs/DECISIONS.md #11)
GEMINI_VISION_MODEL=gemini-flash-model-id
GEMINI_EMBED_MODEL=gemini-embedding-model-id

# --- Cost guard ---
AI_BUDGET_USD=1.00
AI_MAX_CALLS_PER_DAY=500

# --- Alerts (optional) ---
# ALERT_WEBHOOK_URL=https://example.com/webhook
