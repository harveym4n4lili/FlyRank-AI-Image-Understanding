# Copy to .env and fill in. Never commit .env.

# --- App ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Local dev (outside Docker). docker compose overrides this with the internal "db" host.
DATABASE_URL=postgres://app:app@localhost:5432/imagematch
# Folder that POST /jobs/ingest-images may read from (docker compose sets /app/data)
DATA_DIR=data

# API key for the seeded "demo" workspace. Any long random string; leave empty to have
# `npm run seed` generate one and print it once.
DEMO_API_KEY=change-me-to-a-long-random-string

# --- Gemini (free tier, AI Studio key — no credit card) ---
GEMINI_API_KEY=your-ai-studio-key-here
# Models chosen in docs/DESIGN.md decisions log (#11, #14)
GEMINI_VISION_MODEL=gemini-3.8-flash
GEMINI_EMBED_MODEL=gemini-embedding-2
# Calls per minute the worker allows itself (stay under the free-tier limit)
GEMINI_MAX_RPM=8

# --- Cost guard (per workspace, per UTC day) ---
AI_BUDGET_USD=1.00
AI_MAX_CALLS_PER_DAY=500

# --- Alerts (optional): jobs that exhaust their retries are POSTed here ---
# ALERT_WEBHOOK_URL=https://example.com/webhook
